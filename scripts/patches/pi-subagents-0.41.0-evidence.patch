+function artifactEvidence(child: PromptTemplateBridgeChild | undefined): SubagentDelegationArtifact[] {
+	const paths = child?.artifactPaths;
+	if (!paths) return [];
+	return Object.entries(paths).flatMap(([kind, path]) => {
+		if (typeof path !== "string") return [];
+		try {
+			const stat = statSync(path);
+			if (!stat.isFile()) return [];
+			return [{
+				kind: kind.replace(/Path$/, ""),
+				path,
+				sha256: createHash("sha256").update(readFileSync(path)).digest("hex"),
+				bytes: stat.size,
+			}];
+		} catch {
+			return [];
+		}
+	});
